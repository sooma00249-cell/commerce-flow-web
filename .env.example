# App
VITE_APP_NAME=Commerce Flow

# API base path. In dev this is proxied to the backend by vite.config.js.
# For a production build pointing at a separate origin, set the full URL,
# e.g. VITE_API_BASE=https://api.example.com/api
VITE_API_BASE=/api

# Backend used by the Vite dev proxy (not used by the app at runtime).
VITE_PROXY_TARGET=http://localhost:3000
